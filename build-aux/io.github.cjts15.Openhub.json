{
  "id": "io.github.cjts15.Openhub",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "openhub",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--talk-name=org.blueman.Applet",
    "--system-talk-name=org.bluez",
    "--system-talk-name=org.freedesktop.UDisks2"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "build-args": ["--share=network"],
    "env": {
      "RUST_BACKTRACE": "1"
    }
  },
  "cleanup": ["/include", "/lib/pkgconfig", "/share/doc", "*.la", "*.a"],
  "modules": [
    {
      "name": "openhub",
      "buildsystem": "meson",
      "config-opts": ["-Dbuildtype=release"],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": ["target", "_build", "_flatpak", ".flatpak-builder", "repo"]
        }
      ]
    }
  ]
}
