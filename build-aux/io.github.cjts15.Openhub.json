{
  "id": "io.github.cjts15.Openhub",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable",
    "org.freedesktop.Sdk.Extension.llvm21"
  ],
  "command": "openhub",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--filesystem=xdg-run/pipewire-0",
    "--filesystem=xdg-config/wireplumber:create",
    "--filesystem=xdg-data/icc:create",
    "--filesystem=xdg-run/dconf",
    "--filesystem=~/.config/dconf:ro",
    "--talk-name=ca.desrt.dconf",
    "--env=DCONF_USER_CONFIG_DIR=.config/dconf",
    "--env=GIO_EXTRA_MODULES=/app/lib/gio/modules",
    "--env=GSETTINGS_BACKEND=dconf",
    "--device=all",
    "--talk-name=org.blueman.Applet",
    "--talk-name=org.gnome.Mutter.DisplayConfig",
    "--talk-name=org.gnome.Settings",
    "--system-talk-name=org.bluez",
    "--system-talk-name=org.freedesktop.ColorManager",
    "--system-talk-name=org.freedesktop.ratbag1",
    "--system-talk-name=org.freedesktop.UDisks2",
    "--system-talk-name=org.freedesktop.UPower"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/llvm21/bin",
    "build-args": ["--share=network"],
    "env": {
      "RUST_BACKTRACE": "1",
      "LIBCLANG_PATH": "/usr/lib/sdk/llvm21/lib"
    }
  },
  "cleanup": ["/include", "/lib/pkgconfig", "/share/doc", "*.la", "*.a"],
  "modules": [
    {
      "name": "dconf",
      "buildsystem": "meson",
      "config-opts": ["-Dbash_completion=false", "-Dman=false", "-Dvapi=false"],
      "cleanup": ["/bin", "/include", "/lib/pkgconfig", "/libexec", "/share/dbus-1"],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/dconf/0.49/dconf-0.49.0.tar.xz",
          "sha256": "16a47e49a58156dbb96578e1708325299e4c19eea9be128d5bd12fd0963d6c36"
        }
      ]
    },
    {
      "name": "gsd-color-schema",
      "buildsystem": "simple",
      "build-commands": [
        "sed s/@GETTEXT_PACKAGE@/gnome-settings-daemon/ color.gschema.xml.in > org.gnome.settings-daemon.plugins.color.gschema.xml",
        "install -Dm644 -t /app/share/glib-2.0/schemas org.gnome.settings-daemon.plugins.color.gschema.xml",
        "glib-compile-schemas /app/share/glib-2.0/schemas"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://gitlab.gnome.org/GNOME/gnome-settings-daemon/-/raw/50.1/data/org.gnome.settings-daemon.plugins.color.gschema.xml.in",
          "sha256": "1ef2a6fea96c4e309af4317f4410d55cf3b4c9525e0fcff579f871acab172114",
          "dest-filename": "color.gschema.xml.in"
        }
      ]
    },
    {
      "name": "openhub",
      "buildsystem": "meson",
      "config-opts": ["-Dbuildtype=release"],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": ["target", "_build", "_flatpak", ".flatpak-builder", "repo"]
        }
      ]
    }
  ]
}
