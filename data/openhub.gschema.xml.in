<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="openhub">
  <schema id="@APP_ID@" path="/io/github/cjts15/Openhub/">
    <key name="window-width" type="i">
      <default>820</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>640</default>
      <summary>Window height</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Whether the window is maximized</summary>
    </key>
    <key name="last-page" type="s">
      <default>'system'</default>
      <summary>The page shown when Openhub opens</summary>
      <description>The name of a sidebar page, such as “system” or “bluetooth”.</description>
    </key>
  </schema>
</schemalist>
