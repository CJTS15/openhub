<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Openhub</name>
  <summary>Manage your connected devices</summary>
  <description>
    <p>Openhub lists and manages the devices connected to your computer: Bluetooth, USB, power, mice, keyboards and audio.</p>
    <ul>
      <li>Turn Bluetooth on and off</li>
      <li>See your Bluetooth devices, whether they're connected, and their battery level</li>
      <li>Scan for nearby devices and pair them</li>
      <li>Connect, disconnect, trust, block and forget Bluetooth devices</li>
      <li>See your USB devices as they're plugged in, grouped under the hubs they're connected through</li>
      <li>Check a USB device's speed, version, power draw and driver</li>
      <li>Safely eject USB drives</li>
      <li>See your laptop's battery and the battery of every wireless device in one place</li>
      <li>Check battery health, charge cycles and energy</li>
      <li>Preserve battery health by stopping charging at 80%, on laptops that support it</li>
      <li>Change the DPI, scroll wheel and buttons of Logitech, Razer and other gaming mice</li>
      <li>Change the lighting and keys of VIA keyboards, stored on the keyboard</li>
      <li>Choose your audio output and input, set their volume, and see each microphone's level</li>
      <li>Shape each output's sound with a 10-band equalizer or an AutoEQ profile</li>
    </ul>
  </description>
  <developer id="io.github.cjts15">
    <name>CJ</name>
  </developer>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/CJTS15/openhub/main/data/screenshots/bluetooth.png</image>
      <caption>Bluetooth devices, connected ones first, with their batteries</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/CJTS15/openhub/main/data/screenshots/audio.png</image>
      <caption>Audio outputs and inputs, with volume, mute and microphone levels</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/CJTS15/openhub/main/data/screenshots/mouse.png</image>
      <caption>Mice and touchpads, with their connection and battery</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/CJTS15/openhub/main/data/screenshots/keyboard.png</image>
      <caption>Keyboards, with their connection and battery</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/CJTS15/openhub/main/data/screenshots/power.png</image>
      <caption>The laptop's battery, the charge limit and every wireless device's battery</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/CJTS15/openhub/main/data/screenshots/usb.png</image>
      <caption>USB devices, grouped under the hubs they're connected through</caption>
    </screenshot>
  </screenshots>
  <url type="homepage">https://github.com/CJTS15/openhub</url>
  <url type="bugtracker">https://github.com/CJTS15/openhub/issues</url>
  <content_rating type="oars-1.1"/>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <releases>
    <release version="0.4.2" date="2026-10-19">
      <description>
        <p>A new app icon, and clearer setup for the Flatpak:</p>
        <ul>
          <li>A new icon: a ring of devices around a switch, in Catppuccin colours, with a matching symbolic icon</li>
          <li>The README copies the udev rules from the installed Flatpak, so Flatpak users don't need the source code</li>
        </ul>
      </description>
    </release>
    <release version="0.4.1" date="2026-10-19">
      <description>
        <p>Security and reliability fixes:</p>
        <ul>
          <li>The VIA and Razer udev rules now open only the interface Openhub uses, so a keyboard's own interface can't be read by other programs</li>
          <li>A VIA keyboard sending unexpected replies, or an unusual VIA definition file, can no longer crash Openhub</li>
          <li>Equalizer settings are saved only for outputs with ordinary names, so a crafted output name can't change WirePlumber's configuration</li>
        </ul>
      </description>
    </release>
    <release version="0.4.0" date="2026-10-16">
      <description>
        <p>Adds Mouse, Keyboard and Audio pages:</p>
        <ul>
          <li>Logitech mice: DPI, SmartShift and scroll direction, restored automatically when the mouse reconnects</li>
          <li>Razer mice: DPI and polling rate, stored on the mouse; other brands through ratbagd</li>
          <li>VIA keyboards on their cable: lighting and key remapping from the keyboard's VIA definition, and a shortcut to GNOME Settings' keyboard shortcuts</li>
          <li>Audio outputs and inputs: default device, volume, mute, Bluetooth codec and a live microphone level</li>
          <li>A built-in equalizer for each output, with presets and AutoEQ import, that keeps working when Openhub is closed</li>
          <li>Batteries the kernel reports but UPower misses, such as some 2.4 GHz mice</li>
        </ul>
      </description>
    </release>
    <release version="0.3.0" date="2026-10-15">
      <description>
        <p>Adds a Power page:</p>
        <ul>
          <li>The laptop's battery level and charging state, and the battery of every wireless mouse, keyboard or headset UPower knows about, updated live</li>
          <li>Battery details: health, charge cycles, energy, charge rate, voltage and technology</li>
          <li>A "Preserve Battery Health" setting that stops charging at the laptop's limit, shown only where it's supported</li>
          <li>Low batteries shown in the warning colour</li>
        </ul>
        <p>On the USB page, a wireless receiver now shows the battery of the devices it serves.</p>
      </description>
    </release>
    <release version="0.2.0" date="2026-10-14">
      <description>
        <p>Adds a USB page:</p>
        <ul>
          <li>A live list of USB devices, grouped under the hubs they're connected through, with microphones and speakers recognized</li>
          <li>Details for each device: IDs and serial number (with copy buttons), speed, USB version, power draw, class and driver</li>
          <li>Safe eject for USB drives, including encrypted ones</li>
          <li>Built-in devices such as cameras and fingerprint readers hidden unless you ask for them</li>
        </ul>
        <p>Bluetooth: connected devices are listed first, connecting shows progress, pairing pauses scanning, and blueman's connection notifications, which can freeze GNOME Shell, are turned off when blueman is running.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-13">
      <description>
        <p>The first release, for Bluetooth: power the adapter on and off, connect and disconnect paired devices, scan for and pair new ones, and trust, block or forget them.</p>
      </description>
    </release>
  </releases>
</component>
